# VoiceOps 2026 - ZentroMart AI Customer Support Agent
# Environment Variables Configuration Template
# Copy this file to .env and fill in your actual credentials. Never commit your .env!

# LLM Provider Configuration (gemini, openai, or local)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.25

# Gnani.ai Voice Services (STT and TTS)
# Obtain your key from https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_LANG=en-IN
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANG=en-IN

# Dataset path override (optional, defaults to local folder)
DATASET_DIR=
