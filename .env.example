# ============================================================
# VoiceOps 2026 - ZentroMart AI Customer Support Agent
# Environment Configuration Template
# Copy this file to .env and add your actual credentials.
# NEVER commit .env or expose real API keys.
# ============================================================

# ---------------- LLM Provider ----------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Add the API key for your selected provider
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ---------------- Embedding & Retrieval ----------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.25

# ---------------- Gnani.ai STT & TTS ----------------
# Get credentials from https://app.gnani.ai/voice

GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_LANG=en-IN
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANG=en-IN

# ---------------- Dataset Configuration ----------------
# Update this path if your dataset is stored elsewhere.
DATASET_DIR=./Capstone_Project_Dataset_FTTT_2026